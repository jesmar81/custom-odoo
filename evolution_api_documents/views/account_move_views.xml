<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" type="object" string="WhatsApp"
                        icon="fa-whatsapp" groups="evolution_api.group_evolution_user"
                        invisible="not id or not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
