<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_purge_driver_positions" model="ir.cron">
        <field name="name">Logistics: purge old GPS positions</field>
        <field name="model_id" ref="model_logistics_position"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_old_positions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_driver_license_expiration" model="ir.cron">
        <field name="name">Logistics: driver license expiration reminder</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_license_expiration()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
