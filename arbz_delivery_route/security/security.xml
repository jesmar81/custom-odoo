<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record model="ir.module.category" id="module_category_abz_logistics">
        <field name="name">Airibuz Logistics</field>
    </record>

    <record model="res.groups.privilege" id="privilege_abz_logistics">
        <field name="name">Airibuz Logistics</field>
        <field name="category_id" ref="module_category_abz_logistics"/>
    </record>

    <!-- Drivers only see and operate their own stops (mobile app). -->
    <record id="group_logistics_driver" model="res.groups">
        <field name="name">Logistics Driver</field>
        <field name="sequence">5</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="privilege_id" ref="privilege_abz_logistics"/>
    </record>

    <record id="group_logistics_user" model="res.groups">
        <field name="name">Logistics User</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="privilege_id" ref="privilege_abz_logistics"/>
    </record>

    <record id="group_logistics_supervisor" model="res.groups">
        <field name="name">Logistics Supervisor</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_logistics_user'))]"/>
        <field name="privilege_id" ref="privilege_abz_logistics"/>
    </record>

    <record id="group_logistics_manager" model="res.groups">
        <field name="name">Logistics Manager</field>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('group_logistics_supervisor'))]"/>
        <field name="privilege_id" ref="privilege_abz_logistics"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Technical user of the GPS platform (Traccar / vendor webhook) that pushes tracker positions. -->
    <record id="group_logistics_gps_integration" model="res.groups">
        <field name="name">Logistics GPS Integration</field>
    </record>

    <!-- Record rules -->
    <record id="rule_logistics_route_company" model="ir.rule">
        <field name="name">Logistics route: multi-company</field>
        <field name="model_id" ref="model_logistics_route"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_logistics_route_driver" model="ir.rule">
        <field name="name">Logistics route: driver sees own stops</field>
        <field name="model_id" ref="model_logistics_route"/>
        <field name="domain_force">[('driver_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_logistics_driver'))]"/>
    </record>

    <record id="rule_logistics_route_user" model="ir.rule">
        <field name="name">Logistics route: users see all stops</field>
        <field name="model_id" ref="model_logistics_route"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_logistics_user'))]"/>
    </record>

    <record id="rule_logistics_route_event_company" model="ir.rule">
        <field name="name">Logistics route event: multi-company</field>
        <field name="model_id" ref="model_logistics_route_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_logistics_route_event_driver" model="ir.rule">
        <field name="name">Logistics route event: driver sees own events</field>
        <field name="model_id" ref="model_logistics_route_event"/>
        <field name="domain_force">[('route_id.driver_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_logistics_driver'))]"/>
    </record>

    <record id="rule_logistics_route_event_user" model="ir.rule">
        <field name="name">Logistics route event: users see all events</field>
        <field name="model_id" ref="model_logistics_route_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_logistics_user'))]"/>
    </record>

    <record id="rule_logistics_position_company" model="ir.rule">
        <field name="name">Logistics position: multi-company</field>
        <field name="model_id" ref="model_logistics_position"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_logistics_position_driver" model="ir.rule">
        <field name="name">Logistics position: driver sees own positions</field>
        <field name="model_id" ref="model_logistics_position"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_logistics_driver'))]"/>
    </record>

    <record id="rule_logistics_position_supervisor" model="ir.rule">
        <field name="name">Logistics position: supervisors see all positions</field>
        <field name="model_id" ref="model_logistics_position"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_logistics_supervisor'))]"/>
    </record>
</odoo>
