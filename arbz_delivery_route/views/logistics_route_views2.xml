<odoo>
        <menuitem id="menu_logistics_main_root"
                  name="Logistics"
                  sequence="90"
                  web_icon="arbz_delivery_route,static/description/icon.png"/>

        <!-- Define the tree view for the logistics.route model -->
        <record id="view_logistics_route_tree" model="ir.ui.view">
            <field name="name">logistics.route.tree</field>
            <field name="model">logistics.route</field>
            <field name="arch" type="xml">
                <tree string="Logistics Routes">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="customer_id"/>
                    <field name="branch_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Vista form para el modelo logistics.route -->
        <record model="ir.ui.view" id="view_logistics_route_form">
            <field name="name">logistics.route.form</field>
            <field name="model">logistics.route</field>
            <field name="arch" type="xml">
                <form string="Logistics Route">
                    <header>
                            <button name="action_in_progress" states="draft" string="Confirm" type="object" class="btn-primary" groups="arbz_delivery_route.group_logistics_user,arbz_delivery_route.group_logistics_manager"/>
                            <button name="next_status" states = "requested" string="Assigned" type="object" class="btn-primary" groups="arbz_delivery_route.group_logistics_manager"/>
                            <button name="next_status" states = "assigned" string="On Route" type="object" class="btn-primary" groups="arbz_delivery_route.group_logistics_manager"/>
                            <button name="next_status" states = "on_route" string="Delivery" type="object" class="btn-primary" groups="arbz_delivery_route.group_logistics_driver,arbz_delivery_route.group_logistics_manager"/>
                            <button name="action_in_postponed" states = "postponed" string="Reprogram" type="object" class="btn-primary" groups="arbz_delivery_route.group_logistics_supervisor,arbz_delivery_route.group_logistics_manager"/>
                            <button name="action_postpone" invisible="state not in ['on_route']" string="Postpone" class="oe_highlight" type="object" groups="arbz_delivery_route.group_logistics_supervisor,arbz_delivery_route.group_logistics_manager"/>
                            <button name="action_cancel" string="Cancel" type="object" class="oe_highlight" groups="arbz_delivery_route.group_logistics_supervisor,arbz_delivery_route.group_logistics_manager" invisible="state == 'cancelled' or state=='delivered'"/>
                            <field name="state" widget="statusbar" options="{'clickable': '1'}" />

                    </header>
                    <sheet>

                        <div class="oe_button_box" name="button_box">


                        </div>
                        <div class="oe_title">
                                <label for="name"/>
                                <h1>
                                    <field name="name" placeholder="E.g:  business trip name"
                                        required="1"/>
                                </h1>
                            </div>
                        <group col="2">
                            <group>
                                <field name="customer_id"/>
                                <field name="branch_id"/>
                                <field name="attendant"/>
                                <field name="courier_service_id"/>
                                <field name="payment_method"/>
                                <field name="payment_type"/>
                                <field name="service_type"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="start_time" widget="float_time"/>
                                <field name="end_time" widget="float_time"/>
                                <field name="lunch_start_time" widget="float_time"/>
                                <field name="lunch_end_time" widget="float_time"/>
                                <field name="driver_id" required="['|', ('state', 'in', ['requested', 'assigned', 'on_route', 'delivered', 'postponed', 'cancelled']), False]" invisible="['|', ('state', 'in', ['draft']), False]"/>
                                <field name="vehicle_id" required="['|', ('state', 'in', ['requested', 'assigned', 'on_route', 'delivered', 'postponed', 'cancelled']), False]" invisible="['|', ('state', 'in', ['draft']), False]"/>

                            </group>
                        </group>
                        <notebook>
                            <page string="Purchase Orders">
                                <group>
                                    <field name="purchase_order_id" widget="many2many_tags_link"/>
                                </group>
                            </page>
                            <page string="Sale Orders">
                                <group>
                                    <field name="sale_order_id" widget="many2many_tags_link"/>
                                </group>
                            </page>
                            <page string="Observations">
                                 <group>
                                    <field name="observation"/>
                                </group>
                            </page>
                        </notebook>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>





    <record model="ir.ui.view" id="logistics_route_kanban_view">
      <field name="name">Logistics Route Kanban</field>
      <field name="model">logistics.route</field>
      <field name="arch" type="xml">
      <kanban default_group_by="state" group_create="0" quick_create="false" sample="1" class="o_kanban_small_column">
            <field name="state"/>
            <field name="name"/>
            <field name="customer_id"/>
            <field name="service_type"/>
            <progressbar field="state" colors='{"done": "success", "blocked": "danger"}'/>
            <templates>
                <t t-name="kanban-box">
                <div class="oe_kanban_global_click">
                    <div class="oe_kanban_details">
                    <div class="oe_kanban_record_title">
                        <h4><field name="name"/></h4>
                    </div>
                    <div>
                        <strong>Partner: </strong><field name="customer_id"/>
                    </div>
                    <div>
                        <strong>Service Type: </strong><field name="service_type"/>
                    </div>
                    <div>
                        <strong>Date Route: </strong><field name="date"/>
                    </div>
                    <div>
                        <strong>Star Time: </strong><field name="start_time" widget="float_time"/>
                    </div>
                    <div>
                        <strong>Driver: </strong><field name="driver_id"/>
                    </div>
                    <div>
                        <strong>Vehicle: </strong><field name="vehicle_id"/>
                    </div>

                </div>
                    <!-- <div class="oe_kanban_bottom_right">
                    <field name="state" widget="statusbar" statusbar_colors='{"draft": "blue", "requested": "orange", "assigned": "grey", "on_route": "purple", "delivered": "green", "postponed": "pink", "cancelled": "red"}'/>
                    </div> -->
                </div>
                </t>
            </templates>
        </kanban>
      </field>

    </record>

    <record id="action_logistics" model="ir.actions.act_window">
        <field name="type">ir.actions.act_window</field>
        <field name="name">Logistics</field>
        <field name="res_model">logistics.route</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="target">current</field>
    </record>

    <!-- This Menu Item must have a parent and an action-->
    <menuitem id="logistics_menu_act" name="Logistics" parent="arbz_delivery_route.menu_logistics_main_root" action="arbz_delivery_route.action_logistics" sequence="10 "/>



</odoo>
