<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_logistics" model="ir.ui.view">
        <field name="name">res.partner.form.logistics.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[last()]" position="inside">
                <page string="Logistics" name="logistics">
                    <group>
                        <field name="its_courier_service" widget="boolean_toggle"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
