<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_ai_buyer" model="ir.ui.view">
        <field name="name">purchase.order.form.ai.buyer</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not partner_buys_through_intermediary">
                    <strong>This vendor is bought through an intermediary.</strong>
                    Do not send this request to the vendor: handle it manually with the intermediary.
                </div>
            </xpath>
            <field name="partner_ref" position="after">
                <field name="partner_buys_through_intermediary" invisible="1"/>
                <field name="ai_buyer_request_id" invisible="not ai_buyer_request_id"/>
                <field name="ai_quote_registered" invisible="not ai_buyer_request_id"/>
                <field name="ai_quote_lead_days" invisible="not ai_quote_registered"/>
                <field name="ai_quote_notes" invisible="not ai_quote_registered"/>
            </field>
        </field>
    </record>
</odoo>
