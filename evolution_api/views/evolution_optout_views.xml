<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="evolution_optout_view_list" model="ir.ui.view">
        <field name="name">evolution.optout.list</field>
        <field name="model">evolution.optout</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="source"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="evolution_optout_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Opt-outs</field>
        <field name="res_model">evolution.optout</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
