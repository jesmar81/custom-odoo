<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="evolution_message_view_list" model="ir.ui.view">
        <field name="name">evolution.message.list</field>
        <field name="model">evolution.message</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'failed'" decoration-info="direction == 'in'">
                <field name="create_date"/>
                <field name="direction"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="body"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="evolution_message_view_form" model="ir.ui.view">
        <field name="name">evolution.message.form</field>
        <field name="model">evolution.message</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="state"/>
                            <field name="phone"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="external_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <field name="body"/>
                    <field name="error" invisible="not error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="evolution_message_action" model="ir.actions.act_window">
        <field name="name">Evolution Messages</field>
        <field name="res_model">evolution.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="evolution_message_menu"
              name="Evolution Messages"
              parent="base.menu_custom"
              action="evolution_message_action"
              groups="base.group_system"
              sequence="95"/>
</odoo>
