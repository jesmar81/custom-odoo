<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="evolution_message_view_list" model="ir.ui.view">
        <field name="name">evolution.message.list</field>
        <field name="model">evolution.message</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'failed'" decoration-warning="state == 'draft'"
                  decoration-info="direction == 'in'" decoration-muted="state == 'cancelled'">
                <field name="create_date"/>
                <field name="account_id"/>
                <field name="direction"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="body"/>
                <field name="proposed_by" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="evolution_message_view_form" model="ir.ui.view">
        <field name="name">evolution.message.form</field>
        <field name="model">evolution.message</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reject" type="object" string="Reject / Cancel"
                            invisible="state not in ('draft', 'queued', 'failed')"/>
                    <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="direction"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="author_id"/>
                            <field name="proposed_by" invisible="not proposed_by"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="queued_date"/>
                            <field name="sent_date"/>
                            <field name="attempts"/>
                        </group>
                    </group>
                    <field name="body"/>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                        <field name="res_model" invisible="not res_model"/>
                        <field name="res_id" invisible="not res_model"/>
                        <field name="external_id"/>
                    </group>
                    <field name="error" invisible="not error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="evolution_message_view_search" model="ir.ui.view">
        <field name="name">evolution.message.search</field>
        <field name="model">evolution.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="body"/>
                <filter string="Pending approval" name="pending" domain="[('state', '=', 'draft')]"/>
                <filter string="Queued" name="queued" domain="[('state', '=', 'queued')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Received" name="received" domain="[('direction', '=', 'in')]"/>
                <group>
                    <filter string="Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="evolution_message_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">evolution.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="evolution_message_pending_action" model="ir.actions.act_window">
        <field name="name">Pending approval</field>
        <field name="res_model">evolution.message</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
    </record>
</odoo>
