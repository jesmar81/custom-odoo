<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="evolution_template_view_list" model="ir.ui.view">
        <field name="name">evolution.template.list</field>
        <field name="model">evolution.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="report_id"/>
            </list>
        </field>
    </record>

    <record id="evolution_template_view_form" model="ir.ui.view">
        <field name="name">evolution.template.form</field>
        <field name="model">evolution.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="model" invisible="1"/>
                        <field name="report_id"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <field name="body" placeholder="Hola {{ object.partner_id.name }}, le compartimos la cotización {{ object.name }}."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="evolution_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">evolution.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
