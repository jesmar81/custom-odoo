<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_evolution_send_queue" model="ir.cron">
        <field name="name">WhatsApp: send the queued messages</field>
        <field name="model_id" ref="model_evolution_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_evolution_check_connections" model="ir.cron">
        <field name="name">WhatsApp: check the connection of the accounts</field>
        <field name="model_id" ref="model_evolution_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_connections()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
