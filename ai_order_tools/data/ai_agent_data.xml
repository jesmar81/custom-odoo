<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Give the default agent the database lookup tools and the order tools. -->
    <record id="ai.ai_default_agent" model="ai.agent">
        <field name="topic_ids" eval="[
            Command.link(ref('ai.ai_topic_information_retrieval_query')),
            Command.link(ref('ai_topic_sale_quotations')),
            Command.link(ref('ai_topic_purchase_rfq')),
        ]"/>
    </record>

    <!-- Only fills the system prompt when it is empty, so manual edits survive module updates. -->
    <function model="ai.agent" name="_ai_order_tools_load_default_prompt"/>
</odoo>
